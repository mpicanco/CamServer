# CamServer configuration (copy to .env and adjust)

# HTTP server binding. 0.0.0.0 = reachable at the Raspberry Pi's IP on the LAN.
CAMSERVER_HOST=0.0.0.0
CAMSERVER_PORT=8000

# Directory where the SQLite DB and the encryption secret key live.
# Use an absolute path when running under systemd (see scripts/camserver.service).
CAMSERVER_DATA_DIR=data

# Path to the ffmpeg binary (must be installed on the Raspberry Pi).
CAMSERVER_FFMPEG_BINARY=ffmpeg

# --- ONVIF / RTSP discovery -------------------------------------------------
# How long the WS-Discovery multicast scan listens for responses (seconds).
CAMSERVER_DISCOVERY_TIMEOUT=5.0

# --- Stream transcoding -----------------------------------------------------
CAMSERVER_STREAM_FPS=15
CAMSERVER_STREAM_WIDTH=1280
CAMSERVER_STREAM_QUALITY=5
CAMSERVER_RTSP_TRANSPORT=tcp

# If false (default) camera credentials are fed to ffmpeg on stdin so they
# never appear in the process command line. Set true only if a camera/ffmpeg
# combination fails to authenticate over stdin.
CAMSERVER_CREDS_IN_URL=false

# Extra Host header values to allow (DNS-rebinding protection). Comma separated.
# IP literals, "localhost" and "*.local" are always allowed.
# e.g. CAMSERVER_ALLOWED_HOSTS=cams.mylan.home
CAMSERVER_ALLOWED_HOSTS=

# Minimum seconds between network scans from the same client IP.
CAMSERVER_SCAN_RATE_LIMIT=30

CAMSERVER_LOG_LEVEL=info
